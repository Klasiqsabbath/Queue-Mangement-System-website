# MongoDB Connection (Get from MongoDB Atlas)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net

# JWT Secret (Use any random string)
JWT_SECRET=your_jwt_secret_key_12345

# Cloudinary Config (Sign up free at cloudinary.com)
CLOUDINARY_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret

# Server Port
PORT=4000

# Email (Gmail SMTP) - use a Google App Password if 2FA is enabled
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM=your_gmail_address@gmail.com
BOOKING_NOTIFICATION_EMAIL=booking@prescripto.com

# SMS provider settings
SMS_NOTIFY_API_KEY=850c4e02-e0db-4f68-b92f-1004771c8155
SMS_SENDER_ID=fourofakind

# Frontend URLs (Update after deployment)
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
